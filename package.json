{
  "name": "norizo-dev-room",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "qa:state": "node scripts/validate-phase-state.mjs",
    "qa:workers": "node scripts/validate-worker-state.mjs",
    "qa:browser:managed": "node qa/browser-qa.mjs",
    "qa:browser:local": "node qa/browser-qa-local.mjs",
    "qa:p3:contract": "node qa/selftest.mjs",
    "qa:p3:chromium": "node qa/chromium-selftest.mjs",
    "qa:native-host": "node qa/native-host-selftest.mjs",
    "qa:p4:workers": "node qa/worker-state-selftest.mjs",
    "qa:p5": "node scripts/validate-p5-gates.mjs && node qa/p5-gates-selftest.mjs",
    "qa:maintenance": "node scripts/validate-maintenance-state.mjs && node qa/maintenance-selftest.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "@vercel/functions": "latest"
  }
}

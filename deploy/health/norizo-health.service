[Unit]
Description=NORIZO AI WORK FACTORY local health service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/norizo/system/health
Environment=NORIZO_ROOT=/opt/norizo
Environment=NORIZO_HEALTH_HOST=127.0.0.1
Environment=NORIZO_HEALTH_PORT=8787
Environment=NORIZO_HEALTH_REFRESH_SECONDS=60
ExecStart=/usr/bin/python3 /opt/norizo/system/health/health_server.py
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/norizo/system/health

StandardOutput=journal
StandardError=journal
SyslogIdentifier=norizo-health

[Install]
WantedBy=multi-user.target

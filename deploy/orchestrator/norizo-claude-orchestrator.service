[Unit]
Description=NORIZO Autonomous Claude Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NORIZO_GITHUB_REPO=NORIZO0201/norizo-dev-room
Environment=NORIZO_SHARED_BRANCH=dev-room-p0-p5
Environment=NORIZO_ORCH_POLL_SECONDS=60
ExecStart=/usr/bin/python3 /opt/norizo/norizo-dev-room/deploy/orchestrator/claude_orchestrator.py
Restart=always
RestartSec=10
StartLimitIntervalSec=0
User=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

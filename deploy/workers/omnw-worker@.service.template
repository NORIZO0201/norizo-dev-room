# Template only. Do not install until the corresponding OMNW worker entrypoint
# and environment file have been audited.
#
# Example instance names:
#   omnw-worker@discovery.service
#   omnw-worker@recognition.service
#   omnw-worker@master.service
#
# Before deployment replace <EXECUTABLE> with the audited worker launcher.

[Unit]
Description=OMNW resident worker (%i)
After=network-online.target norizo-health.service
Wants=network-online.target
Requires=norizo-health.service

StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/norizo/oh-my-nihon-wine
EnvironmentFile=-/etc/norizo/omnw-%i.env
ExecStart=<EXECUTABLE> %i

Restart=on-failure
RestartSec=30
# Exit 75 means source blocking / CAPTCHA / access restriction. Do not loop.
RestartPreventExitStatus=75
TimeoutStopSec=30
KillSignal=SIGTERM

MemoryMax=3G
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/norizo/oh-my-nihon-wine /opt/norizo/system /var/log/norizo

StandardOutput=journal
StandardError=journal
SyslogIdentifier=omnw-%i

[Install]
WantedBy=multi-user.target
